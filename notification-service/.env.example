# PostgreSQL (notification_db — processed event ids, complements Redis)
NOTIFICATION_DATABASE_URL=postgres://postgres:postgres@localhost:5432/notification_db?sslmode=disable

# RabbitMQ consumer
NOTIFICATION_RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Redis — required: idempotency by payment_id + job completion marker
NOTIFICATION_REDIS_ADDR=localhost:6379
NOTIFICATION_IDEMPOTENCY_TTL_HOURS=168

# Email provider: SIMULATED (default) or REAL (Mailjet REST)
PROVIDER_MODE=SIMULATED
MAILJET_API_KEY=f25e96ceac7a4325abbf9c4077c24c54
MAILJET_API_SECRET=bf32f49301ef462750c25c8604e2e394
MAILJET_FROM_EMAIL=admin@example.com
MAILJET_FROM_NAME=Example Admin

# Retry / backoff (exponential: base, 2*base, 4*base, ... between attempts)
NOTIFICATION_EMAIL_MAX_ATTEMPTS=4
NOTIFICATION_BACKOFF_BASE_MS=2000

# Simulated provider (PROVIDER_MODE=SIMULATED)
NOTIFICATION_SIM_MIN_LATENCY_MS=50
NOTIFICATION_SIM_MAX_LATENCY_MS=200
NOTIFICATION_SIM_FAIL_RATE=0.2

# Optional: messages whose JSON order_id equals this value are Nacked without requeue (DLQ demo).
# NOTIFICATION_DLQ_DEMO_ORDER_ID=__demo_dlq_order__
