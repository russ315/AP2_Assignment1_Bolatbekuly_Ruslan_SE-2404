# Copy to .env and adjust. Used with docker compose --env-file .env (optional).

# --- Redis (shared) ---
# Hostname redis when using Docker Compose from this repo.

# --- Order service ---
ORDER_REDIS_ADDR=redis:6379
ORDER_CACHE_TTL_SECONDS=300

# --- Notification service ---
NOTIFICATION_REDIS_ADDR=redis:6379
NOTIFICATION_IDEMPOTENCY_TTL_HOURS=168
NOTIFICATION_EMAIL_MAX_ATTEMPTS=4
NOTIFICATION_BACKOFF_BASE_MS=2000
PROVIDER_MODE=SIMULATED
NOTIFICATION_SIM_FAIL_RATE=0.2

# Mailjet (PROVIDER_MODE=REAL)
MAILJET_API_KEY=
MAILJET_API_SECRET=
MAILJET_FROM_EMAIL=
MAILJET_FROM_NAME=
